rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fabric swatch photos (Fabrics page "Add New Fabric" image upload)
    match /fabrics/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Sample tracking work photos
    match /samples/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Sample certificate swatch photos (order-bound reports)
    match /sampleCertificates/{orderId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Standalone new-fabric sample report swatch photos
    // (Fabric Archive → "New Sample" → becomes a fabric)
    match /fabricSamples/{sampleId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
